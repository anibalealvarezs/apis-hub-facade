{
    "$schema":  "https://getcomposer.org/schema.json",
    "name":  "laravel/laravel",
    "type":  "project",
    "description":  "The skeleton application for the Laravel framework.",
    "keywords":  [
                     "laravel",
                     "framework"
                 ],
    "license":  "MIT",
    "require":  {
                    "anibalealvarezs/apis-hub-api":  "^0.1.1",
                    "anibalealvarezs/facebook-graph-api":  "1.0.0",
                    "anibalealvarezs/google-api":  "1.0.0",
                    "bezhansalleh/filament-language-switch":  "^3.1",
                    "bezhansalleh/filament-shield":  "^3.2",
                    "filament/filament":  "^3.2",
                    "filament/spatie-laravel-settings-plugin":  "^3.2",
                    "filament/spatie-laravel-translatable-plugin":  "^3.3",
                    "google/recaptcha":  "^1.3",
                    "jeffgreco13/filament-breezy":  "^2.6",
                    "laravel/cashier":  "^16.5",
                    "laravel/framework":  "^12.0",
                    "laravel/octane":  "^2.17",
                    "laravel/socialite":  "^5.26",
                    "laravel/tinker":  "^2.10.1",
                    "predis/predis":  "^3.4",
                    "spatie/laravel-settings":  "^3.0",
                    "spatie/laravel-translatable":  "^6.14",
                    "srmklive/paypal":  "^3.1",
                    "php":  ">=8.3"
                },
    "require-dev":  {
                        "pestphp/pest":  "^3.8",
                        "laravel/pint":  "^1.24",
                        "nunomaduro/collision":  "^8.6",
                        "phpunit/phpunit":  "^11.5.50",
                        "fakerphp/faker":  "^1.23",
                        "laravel/sail":  "^1.41",
                        "laravel/pail":  "^1.2.2",
                        "pestphp/pest-plugin-laravel":  "^3.2",
                        "doctrine/instantiator":  "^1.5",
                        "friendsofphp/php-cs-fixer":  "^3.94",
                        "mockery/mockery":  "^1.6"
                    },
    "autoload":  {
                     "psr-4":  {
                                   "App\\":  "app/",
                                   "Database\\Factories\\":  "database/factories/",
                                   "Database\\Seeders\\":  "database/seeders/"
                               }
                 },
    "autoload-dev":  {
                         "psr-4":  {
                                       "Tests\\":  "tests/"
                                   }
                     },
    "scripts":  {
                    "setup":  [
                                  "composer install",
                                  "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
                                  "@php artisan key:generate",
                                  "@php artisan migrate --force",
                                  "npm install",
                                  "npm run build"
                              ],
                    "dev":  [
                                "Composer\\Config::disableProcessTimeout",
                                "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
                            ],
                    "test":  [
                                 "@php artisan config:clear --ansi",
                                 "@php artisan test"
                             ],
                    "post-autoload-dump":  [
                                               "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
                                               "@php artisan package:discover --ansi",
                                               "@php artisan filament:upgrade"
                                           ],
                    "post-update-cmd":  [
                                            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
                                        ],
                    "post-root-package-install":  [
                                                      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
                                                  ],
                    "post-create-project-cmd":  [
                                                    "@php artisan key:generate --ansi",
                                                    "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
                                                    "@php artisan migrate --graceful --ansi"
                                                ]
                },
    "repositories":  [
                         {
                             "type":  "composer",
                             "url":  "https://satis.anibalalvarez.com"
                         }
                     ],
    "extra":  {
                  "laravel":  {
                                  "dont-discover":  [

                                                    ]
                              }
              },
    "config":  {
                   "optimize-autoloader":  false,
                   "preferred-install":  "dist",
                   "sort-packages":  true,
                   "allow-plugins":  {
                                         "pestphp/pest-plugin":  true,
                                         "php-http/discovery":  true
                                     },
                   "platform":  {
                                    "php":  "8.3.0"
                                }
               },
    "minimum-stability":  "dev",
    "prefer-stable":  true
}